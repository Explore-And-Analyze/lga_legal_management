<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Catégorie pour les groupes juridiques -->
    <record id="module_category_legal_management" model="ir.module.category">
        <field name="name">Legal Management</field>
        <field name="description">Modules for law firm management</field>
        <field name="sequence">10</field>
    </record>

    <!-- Groupes d'utilisateurs -->
    <record id="group_legal_user" model="res.groups">
        <field name="name">Utilisateur / Avocat</field>
        <field name="category_id" ref="module_category_legal_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Accès de base aux dossiers juridiques</field>
    </record>

    <record id="group_legal_manager" model="res.groups">
        <field name="name">Manager / Avocat Principal</field>
        <field name="category_id" ref="module_category_legal_management"/>
        <field name="implied_ids" eval="[(4, ref('group_legal_user'))]"/>
        <field name="comment">Accès complet à tous les dossiers</field>
    </record>

    <!-- Règles d'enregistrement simples -->
    <record id="legal_case_rule_user" model="ir.rule">
        <field name="name">Dossier: accès utilisateur</field>
        <field name="model_id" ref="model_legal_case"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_legal_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="legal_case_rule_manager" model="ir.rule">
        <field name="name">Dossier: accès manager</field>
        <field name="model_id" ref="model_legal_case"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_legal_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>