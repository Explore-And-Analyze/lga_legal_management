#. module: lga_legal_management_community
#: model:mail.template,body_html:lga_legal_management_community.email_template_portal_invitation
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e0e0e0; border-radius: 10px;\">\n"
"                    <div style=\"text-align: center; margin-bottom: 30px;\">\n"
"                        <h2 style=\"color: #1e40af;\">Bienvenue sur le portail client</h2>\n"
"                        <h3 style=\"color: #4b5563;\">\${object.company_id.name}</h3>\n"
"                    </div>\n"
"                    \n"
"                    <p>Bonjour <strong>\${object.name}</strong>,</p>\n"
"                    \n"
"                    <p>Nous vous invitons à accéder à votre espace client sécurisé où vous pourrez :</p>\n"
"                    <ul style=\"margin: 20px 0;\">\n"
"                        <li>Consulter vos dossiers juridiques</li>\n"
"                        <li>Voir vos audiences programmées</li>\n"
"                        <li>Suivre vos délais importants</li>\n"
"                        <li>Télécharger vos documents</li>\n"
"                        <li>Gérer vos consentements RGPD</li>\n"
"                    </ul>\n"
"                    \n"
"                    <div style=\"text-align: center; margin: 30px 0;\">\n"
"                        <a href=\"%24%7Bobject.portal_login_url%7D\" style=\"background-color: #1e40af; color: white; padding: 12px 24px; text-decoration: none; border-radius: 5px; display: inline-block;\">\n"
"                            Accéder à mon espace client\n"
"                        </a>\n"
"                    </div>\n"
"                    \n"
"                    <p style=\"margin-top: 30px;\">Si le bouton ne fonctionne pas, copiez et collez ce lien dans votre navigateur :</p>\n"
"                    <p style=\"word-break: break-all; background-color: #f3f4f6; padding: 10px; border-radius: 5px;\">\n"
"                        \${object.portal_login_url}\n"
"                    </p>\n"
"                    \n"
"                    <hr style=\"margin: 20px 0; border: none; border-top: 1px solid #e0e0e0;\"/>\n"
"                    \n"
"                    <p style=\"font-size: 12px; color: #666;\">\n"
"                        Cet email a été envoyé automatiquement. Pour toute question, veuillez contacter notre cabinet.\n"
"                        <br/>\n"
"                        Si vous n'avez pas demandé cet accès, veuillez ignorer cet email.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e0e0e0; border-radius: 10px;\">\n"
"                    <div style=\"text-align: center; margin-bottom: 30px;\">\n"
"                        <h2 style=\"color: #1e40af;\">Welcome to the Client Portal</h2>\n"
"                        <h3 style=\"color: #4b5563;\">\${object.company_id.name}</h3>\n"
"                    </div>\n"
"                    \n"
"                    <p>Hello <strong>\${object.name}</strong>,</p>\n"
"                    \n"
"                    <p>We invite you to access your secure client area where you can:</p>\n"
"                    <ul style=\"margin: 20px 0;\">\n"
"                        <li>View your legal cases</li>\n"
"                        <li>See your scheduled hearings</li>\n"
"                        <li>Track your important deadlines</li>\n"
"                        <li>Download your documents</li>\n"
"                        <li>Manage your GDPR consents</li>\n"
"                    </ul>\n"
"                    \n"
"                    <div style=\"text-align: center; margin: 30px 0;\">\n"
"                        <a href=\"%24%7Bobject.portal_login_url%7D\" style=\"background-color: #1e40af; color: white; padding: 12px 24px; text-decoration: none; border-radius: 5px; display: inline-block;\">\n"
"                            Access my client area\n"
"                        </a>\n"
"                    </div>\n"
"                    \n"
"                    <p style=\"margin-top: 30px;\">If the button does not work, copy and paste this link into your browser:</p>\n"
"                    <p style=\"word-break: break-all; background-color: #f3f4f6; padding: 10px; border-radius: 5px;\">\n"
"                        \${object.portal_login_url}\n"
"                    </p>\n"
"                    \n"
"                    <hr style=\"margin: 20px 0; border: none; border-top: 1px solid #e0e0e0;\"/>\n"
"                    \n"
"                    <p style=\"font-size: 12px; color: #666;\">\n"
"                        This email was sent automatically. For any questions, please contact our office.<br/>\n"
"                        If you did not request this access, please ignore this email.\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: lga_legal_management_community
#: model:mail.template,body_html:lga_legal_management_community.email_template_data_ready
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n"
"                    <h2 style=\"color: #1e40af;\">Vos données sont prêtes</h2>\n"
"                    \n"
"                    <p>Bonjour <strong>\${object.partner_id.name}</strong>,</p>\n"
"                    \n"
"                    <p>Votre demande d'export de données a été traitée.</p>\n"
"                    \n"
"                    <div style=\"text-align: center; margin: 30px 0;\">\n"
"                        <a href=\"/web/content/gdpr.data.request/%24%7Bobject.id%7D/response_data/%24%7Bobject.response_filename%7D\" style=\"background-color: #1e40af; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;\">\n"
"                            Télécharger mes données\n"
"                        </a>\n"
"                    </div>\n"
"                    \n"
"                    <p>Ce lien expirera dans 7 jours.</p>\n"
"                    \n"
"                    <hr style=\"margin: 20px 0;\"/>\n"
"                    \n"
"                    <p style=\"font-size: 12px; color: #666;\">\n"
"                        Cet email a été envoyé automatiquement.<br/>\n"
"                        Pour toute question, veuillez contacter notre cabinet.\n"
"                    </p>\n"
"                    \n"
"                    <p>Cordialement,<br/>\${object.company_id.name}</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n"
"                    <h2 style=\"color: #1e40af;\">Your data is ready</h2>\n"
"                    \n"
"                    <p>Hello <strong>\${object.partner_id.name}</strong>,</p>\n"
"                    \n"
"                    <p>Your data export request has been processed.</p>\n"
"                    \n"
"                    <div style=\"text-align: center; margin: 30px 0;\">\n"
"                        <a href=\"/web/content/gdpr.data.request/%24%7Bobject.id%7D/response_data/%24%7Bobject.response_filename%7D\" style=\"background-color: #1e40af; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;\">\n"
"                            Download my data\n"
"                        </a>\n"
"                    </div>\n"
"                    \n"
"                    <p>This link will expire in 7 days.</p>\n"
"                    \n"
"                    <hr style=\"margin: 20px 0;\"/>\n"
"                    \n"
"                    <p style=\"font-size: 12px; color: #666;\">\n"
"                        This email was sent automatically.<br/>\n"
"                        For any questions, please contact our office.\n"
"                    </p>\n"
"                    \n"
"                    <p>Best regards,<br/>\${object.company_id.name}</p>\n"
"                </div>\n"
"            "

